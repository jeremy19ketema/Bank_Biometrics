# ==========================================
# AEGIS BIOMETRIC BANKING - ENVIRONMENT CONFIG
# ==========================================

# Database Configurations
POSTGRES_DB=aegis_biometrics_db
POSTGRES_USER=aegis_admin
POSTGRES_PASSWORD=replace-with-a-strong-unique-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://aegis_admin:replace-with-a-strong-unique-password@localhost:5432/aegis_biometrics_db?schema=public

# Backend API Configuration
BACKEND_PORT=5000
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:3000

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Classroom demo only. Enables transactions to follow the normal workflow
# without a physical fingerprint or iris scanner. This is ignored in production.
BIOMETRIC_DEMO_BYPASS=false
