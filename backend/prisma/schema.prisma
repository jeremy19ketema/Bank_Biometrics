datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  SUPER_ADMIN_MANAGER
  SUPER_ADMIN_IT
  SUPER_ADMIN_FOREX
  BANK_MANAGER
  BRANCH_IT
  ACCOUNTANT
  HR
}

enum BranchStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum StaffStatus {
  PENDING_APPROVAL
  PENDING_FIRST_LOGIN
  ACTIVE
  ON_LEAVE
  SUSPENDED
  INACTIVE
  LOCKED
  DISABLED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CustomerStatus {
  ACTIVE
  FLAGGED
  FROZEN
}

enum TransactionType {
  CASH_WITHDRAWAL
  CHEQUE_DEPOSIT
  CHEQUE_CLEARANCE
  TRANSFER
}

enum TransactionStatus {
  PENDING_APPROVAL
  COMPLETED
  REJECTED
  FLAGGED
}

enum AuditCategory {
  SECURITY
  TRANSACTION
  BIOMETRIC
  ADMINISTRATION
}

enum AuditStatus {
  SUCCESS
  WARNING
  FAILURE
}

model User {
  id           String      @id @default(uuid())
  username     String      @unique
  fullName     String
  email        String
  passwordHash String      // For passcode security
  role         Role
  branchId     String?
  branch       Branch?     @relation(fields: [branchId], references: [id])
  department   String?
  avatarUrl    String?
  isActive     Boolean     @default(true)
  status       StaffStatus @default(PENDING_FIRST_LOGIN)
  isFirstLogin Boolean     @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // Relationships
  processedTransactions Transaction[] @relation("AccountantRelation")
  approvedTransactions  Transaction[] @relation("ApproverRelation")
  auditLogs             SystemAuditLog[]
  biometricScans        BiometricScanResult[]
  approvalRequests      ApprovalRequest[] @relation("ApprovalRequester")
  approvalActions       ApprovalRequest[] @relation("ApprovalActor")
  passkeys              PasskeyCredential[]
}

model Branch {
  id                    String        @id @default(uuid())
  code                  String        @unique
  name                  String
  city                  String
  address               String
  phone                 String
  email                 String
  status                BranchStatus  @default(ACTIVE)
  dailyTransactionLimit Float
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  // Relationships
  users        User[]
  transactions Transaction[]
}

model Customer {
  id                  String         @id @default(uuid())
  accountNumber       String         @unique
  fullName            String
  nationalId          String         @unique
  phone               String
  email               String
  accountType         String         // e.g. SAVINGS, CHECKING, CORPORATE
  balance             Float
  isBiometricEnrolled Boolean        @default(false)
  enrolledFingerprints String[]      // biometric template markers (simulated)
  status              CustomerStatus @default(ACTIVE)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  // Relationships
  biometricScans      BiometricScanResult[]
}

model BiometricScanResult {
  scanId       String    @id @default(uuid())
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id])
  matchScore   Float     // 0 - 100
  isMatch      Boolean
  fingerIndex  String    // e.g. "RIGHT_INDEX"
  qualityScore Float
  scannedAt    DateTime  @default(now())
  deviceId     String
  operatorId   String
  operator     User      @relation(fields: [operatorId], references: [id])
}

model Transaction {
  id                String            @id @default(uuid())
  referenceNumber   String            @unique
  accountNumber     String
  customerName      String
  type              TransactionType
  amount            Float
  status            TransactionStatus @default(PENDING_APPROVAL)
  biometricVerified Boolean           @default(false)
  accountantId      String
  accountant        User              @relation("AccountantRelation", fields: [accountantId], references: [id])
  branchId          String
  branch            Branch            @relation(fields: [branchId], references: [id])
  approvedById      String?
  approvedBy        User?             @relation("ApproverRelation", fields: [approvedById], references: [id])
  timestamp         DateTime          @default(now())
}

model SystemAuditLog {
  id        String        @id @default(uuid())
  timestamp DateTime      @default(now())
  actorId   String
  actor     User          @relation(fields: [actorId], references: [id])
  action    String
  category  AuditCategory
  ipAddress String
  details   String
  status    AuditStatus
}

model ApprovalRequest {
  id              String         @id @default(uuid())
  requestType     String         // e.g. "CREATE_BANK_MANAGER", "DELETE_BRANCH", "CREATE_SUPER_ADMIN_ROLE"
  requestedById   String
  requestedBy     User           @relation("ApprovalRequester", fields: [requestedById], references: [id])
  requestedByName String
  targetUserId    String?        // If request is about a user
  targetRole      Role?          // Role being requested
  targetBranchId  String?
  details         String
  status          ApprovalStatus @default(PENDING)
  approvedById    String?
  approvedBy      User?          @relation("ApprovalActor", fields: [approvedById], references: [id])
  rejectionReason String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model PasskeyCredential {
  id           String   @id // The credential ID base64url encoded
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  publicKey    Bytes
  counter      BigInt
  transports   String[] // Array of transports like 'internal', 'usb', 'ble', 'nfc'
  createdAt    DateTime @default(now())
}
