datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  SUPER_ADMIN_MANAGER
  SUPER_ADMIN_IT
  SUPER_ADMIN_FOREX
  BANK_MANAGER
  BRANCH_IT
  ACCOUNTANT
  HR
  // We keep the enum for bootstrap/essential platform identities
}

enum BranchStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
  SUSPENDED
}

enum StaffStatus {
  PENDING_APPROVAL
  PENDING_FIRST_LOGIN
  ACTIVE
  ON_LEAVE
  SUSPENDED
  INACTIVE
  LOCKED
  DISABLED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CustomerStatus {
  ACTIVE
  FLAGGED
  FROZEN
}

enum TransactionType {
  CASH_WITHDRAWAL
  CHEQUE_DEPOSIT
  CHEQUE_CLEARANCE
  TRANSFER
}

enum TransactionStatus {
  PENDING_APPROVAL
  COMPLETED
  REJECTED
  FLAGGED
}

enum AuditCategory {
  SECURITY
  TRANSACTION
  BIOMETRIC
  ADMINISTRATION
  POLICY_CHANGE
}

enum AuditStatus {
  SUCCESS
  WARNING
  FAILURE
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DeviceStatus {
  ONLINE
  OFFLINE
  UNASSIGNED
  REPAIR
  RETIRED
}

enum AttendanceType {
  IN
  OUT
}

enum LeaveType {
  SICK
  ANNUAL
  MATERNITY
  PATERNITY
  UNPAID
}

// --- ORGANIZATIONAL HIERARCHY ---

model Organization {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String   @unique
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  regions     Region[]
  departments Department[]
}

model Region {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  code           String       @unique
  status         String       @default("ACTIVE")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  branches    Branch[]
  departments Department[]
}

model Department {
  id             String        @id @default(uuid())
  name           String
  code           String        @unique
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  regionId       String?
  region         Region?       @relation(fields: [regionId], references: [id])
  branchId       String?
  branch         Branch?       @relation(fields: [branchId], references: [id])
  status         String        @default("ACTIVE")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  users User[]
}

model CostCenter {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  budget    Float?
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- DYNAMIC ROLES & PERMISSIONS ---

model CustomRole {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions CustomPermission[]
  users       UserCustomRole[]
}

model CustomPermission {
  id          String   @id @default(uuid())
  name        String   @unique // e.g. "VIEW_REPORTS", "MANAGE_FOREX"
  description String?
  createdAt   DateTime @default(now())

  roles CustomRole[]
}

model UserCustomRole {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  customRoleId String
  customRole   CustomRole @relation(fields: [customRoleId], references: [id])
  scopeType    String? // e.g., "GLOBAL", "REGION", "BRANCH", "DEPARTMENT"
  scopeId      String? // UUID of the specific scope entity
  assignedAt   DateTime   @default(now())
  assignedById String?
}

// --- GLOBAL POLICIES ---

model GlobalSecurityPolicy {
  id                    String   @id @default(uuid())
  name                  String   @unique
  mfaRequired           Boolean  @default(false)
  sessionTimeoutMinutes Int      @default(30)
  passwordRegex         String   @default("^(?=.*[A-Za-z])(?=.*\\d)[A-Za-z\\d]{8,}$")
  maxFailedAttempts     Int      @default(5)
  accountLockoutMinutes Int      @default(15)
  ipRestrictions        String[]
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model BiometricPolicy {
  id                   String   @id @default(uuid())
  name                 String   @unique
  requireMultiFinger   Boolean  @default(false)
  retentionDays        Int      @default(365)
  strictMatchThreshold Float    @default(85.0)
  allowReEnrollment    Boolean  @default(true)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

// --- INTEGRATIONS & ALERTS ---

model SystemBackup {
  id              String    @id @default(uuid())
  type            String
  status          String
  sizeBytes       BigInt?
  path            String?
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  lastRestoreTest DateTime?
  restoreStatus   String?
}

model MaintenanceWindow {
  id              String   @id @default(uuid())
  title           String
  description     String
  startTime       DateTime
  endTime         DateTime
  status          String   @default("SCHEDULED")
  createdById     String
  createdBy       User     @relation(fields: [createdById], references: [id])
}

model SystemIntegration {
  id               String    @id @default(uuid())
  name             String    @unique
  type             String
  endpoint         String?
  encryptedKey     String?
  iv               String?
  authTag          String?
  secretKeyVersion Int       @default(1)
  status           String    @default("ACTIVE")
  isDeleted        Boolean   @default(false)
  lastSyncAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model SecurityAlert {
  id              String        @id @default(uuid())
  severity        AlertSeverity @default(MEDIUM)
  eventType       String
  description     String
  sourceIp        String?
  targetUserId    String?
  isResolved      Boolean       @default(false)
  resolvedAt      DateTime?
  assignedToId    String?
  assignedTo      User?         @relation(fields: [assignedToId], references: [id])
  acknowledgedAt  DateTime?
  escalationLevel String        @default("TIER_1")
  createdAt       DateTime      @default(now())
}

// --- CORE SYSTEM MODELS ---

model User {
  id            String      @id @default(uuid())
  username      String      @unique
  fullName      String
  email         String      @unique
  passwordHash  String
  role          Role
  branchId      String?
  branch        Branch?     @relation(fields: [branchId], references: [id])
  departmentId  String?
  departmentRef Department? @relation(fields: [departmentId], references: [id])
  department    String?     // Kept for backward compatibility with existing code where department is a string
  avatarUrl     String?
  isActive      Boolean     @default(true)
  status        StaffStatus @default(PENDING_FIRST_LOGIN)
  isFirstLogin  Boolean     @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Relationships
  customRoles           UserCustomRole[]
  processedTransactions Transaction[]         @relation("AccountantRelation")
  approvedTransactions  Transaction[]         @relation("ApproverRelation")
  auditLogs             SystemAuditLog[]
  biometricScans        BiometricScanResult[]
  approvalRequests      ApprovalRequest[]     @relation("ApprovalRequester")
  approvalActions       ApprovalRequest[]     @relation("ApprovalActor")
  securityAlerts        SecurityAlert[]
  maintenanceWindows    MaintenanceWindow[]
  passwordResetTokens   PasswordResetToken[]
  biometricConsent      StaffBiometricConsent?
  attendanceEvents      AttendanceEvent[]
  attendanceAdjustmentsRequested AttendanceAdjustment[] @relation("AdjustmentRequester")
  attendanceAdjustmentsApproved  AttendanceAdjustment[] @relation("AdjustmentApprover")
  leaveRequestsRequested         LeaveRequest[]         @relation("LeaveRequester")
  leaveRequestsApproved          LeaveRequest[]         @relation("LeaveApprover")
  overtimeRequestsRequested      OvertimeRequest[]      @relation("OvertimeRequester")
  overtimeRequestsApproved       OvertimeRequest[]      @relation("OvertimeApprover")
}

model Branch {
  id                    String       @id @default(uuid())
  regionId              String?
  region                Region?      @relation(fields: [regionId], references: [id])
  code                  String       @unique
  name                  String
  city                  String
  address               String
  phone                 String
  email                 String
  status                BranchStatus @default(ACTIVE)
  dailyTransactionLimit Float
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  // Relationships
  users        User[]
  transactions Transaction[]
  departments  Department[]
  biometricDevices BiometricDevice[]
}

model Customer {
  id                   String         @id @default(uuid())
  accountNumber        String         @unique
  fullName             String
  nationalId           String         @unique
  phone                String
  email                String
  accountType          String
  balance              Float
  isBiometricEnrolled  Boolean        @default(false)
  enrolledFingerprints String[]
  status               CustomerStatus @default(ACTIVE)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  // Relationships
  biometricScans BiometricScanResult[]
}

model BiometricScanResult {
  scanId       String    @id @default(uuid())
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id])
  matchScore   Float
  isMatch      Boolean
  fingerIndex  String
  qualityScore Float
  scannedAt    DateTime  @default(now())
  deviceId     String
  operatorId   String
  operator     User      @relation(fields: [operatorId], references: [id])
}

model Transaction {
  id                String            @id @default(uuid())
  referenceNumber   String            @unique
  accountNumber     String
  customerName      String
  type              TransactionType
  amount            Float
  status            TransactionStatus @default(PENDING_APPROVAL)
  biometricVerified Boolean           @default(false)
  accountantId      String
  accountant        User              @relation("AccountantRelation", fields: [accountantId], references: [id])
  branchId          String
  branch            Branch            @relation(fields: [branchId], references: [id])
  approvedById      String?
  approvedBy        User?             @relation("ApproverRelation", fields: [approvedById], references: [id])
  timestamp         DateTime          @default(now())
}

model SystemAuditLog {
  id             String        @id @default(uuid())
  timestamp      DateTime      @default(now())
  actorId        String
  actor          User          @relation(fields: [actorId], references: [id])
  action         String
  category       AuditCategory
  severity       AlertSeverity @default(LOW)
  ipAddress      String
  details        String
  status         AuditStatus
  organizationId String?
  regionId       String?
  branchId       String?
  departmentId   String?
  targetType     String?
  targetId       String?
}

model ApprovalRequest {
  id              String         @id @default(uuid())
  requestType     String
  requestedById   String
  requestedBy     User           @relation("ApprovalRequester", fields: [requestedById], references: [id])
  requestedByName String
  targetUserId    String?
  targetRole      Role?
  targetBranchId  String?
  details         String
  status          ApprovalStatus @default(PENDING)
  approvedById    String?
  approvedBy      User?          @relation("ApprovalActor", fields: [approvedById], references: [id])
  rejectionReason String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  tokenHash String   @unique
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// --- PHASE 6: DEVICE & HR OPERATIONS ---

model BiometricDevice {
  id             String       @id @default(uuid())
  macAddress     String       @unique
  ipAddress      String?
  name           String
  secretKeyHash  String       // For HMAC/Token based auth
  status         DeviceStatus @default(UNASSIGNED)
  branchId       String?
  branch         Branch?      @relation(fields: [branchId], references: [id])
  lastSyncAt     DateTime?
  firmwareVersion String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  attendanceEvents AttendanceEvent[]
}

model StaffBiometricConsent {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id])
  consentVersion    String
  captureMethod     String   // e.g. "DIGITAL_SIGNATURE", "SCANNED_PAPER"
  documentReference String?
  isRevoked         Boolean  @default(false)
  revokedAt         DateTime?
  signedTimestamp   DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model AttendanceEvent {
  id                String         @id @default(uuid())
  deviceEventId     String         @unique // Idempotency key
  userId            String
  user              User           @relation(fields: [userId], references: [id])
  deviceId          String
  device            BiometricDevice @relation(fields: [deviceId], references: [id])
  type              AttendanceType
  deviceTimestamp   DateTime
  receivedTimestamp DateTime       @default(now())
  timezone          String         @default("UTC")
  source            String         @default("DEVICE") // DEVICE, MANUAL_ADJUSTMENT

  adjustments       AttendanceAdjustment[]
}

model AttendanceAdjustment {
  id                String         @id @default(uuid())
  attendanceEventId String
  attendanceEvent   AttendanceEvent @relation(fields: [attendanceEventId], references: [id])
  adjustedTimestamp DateTime
  adjustedType      AttendanceType
  reason            String
  requestedById     String
  requestedBy       User           @relation("AdjustmentRequester", fields: [requestedById], references: [id])
  approvedById      String?
  approvedBy        User?          @relation("AdjustmentApprover", fields: [approvedById], references: [id])
  status            ApprovalStatus @default(PENDING)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model LeaveRequest {
  id            String         @id @default(uuid())
  userId        String
  user          User           @relation("LeaveRequester", fields: [userId], references: [id])
  startDate     DateTime
  endDate       DateTime
  type          LeaveType
  reason        String
  status        ApprovalStatus @default(PENDING)
  approvedById  String?
  approvedBy    User?          @relation("LeaveApprover", fields: [approvedById], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model OvertimeRequest {
  id            String         @id @default(uuid())
  userId        String
  user          User           @relation("OvertimeRequester", fields: [userId], references: [id])
  date          DateTime
  hours         Float
  reason        String
  status        ApprovalStatus @default(PENDING)
  approvedById  String?
  approvedBy    User?          @relation("OvertimeApprover", fields: [approvedById], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}
